#!/usr/bin/env bash
#
# Master entry point for the Beyond grep demo. Dispatches to the
# subcommand scripts in scripts/.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPTS="$SCRIPT_DIR/scripts"

usage() {
  cat <<'EOF'
Usage: ./demo <command> [args]

Commands:
  init [--skip-build|--skip-index|--with-eureka|--clean|--reset]
                                  One-time setup: clone repos, build LSTs, index.
                                  Pass --with-eureka to also provision Netflix/eureka
                                  into both lanes (beefier side-by-side option).

  reset [media|petclinic|eureka|all]
                                  Per-rehearsal reset of the agent lanes.
                                  Default target: all (eureka reset is skipped
                                  unless that lane was provisioned).

  trap status|enable|disable      Toggle the optional 'trap' variant of the
                                  media lane (recipe leaves a setErrorHandler
                                  call the agent has to fix manually).

  agent [no|with] [media|petclinic|eureka] [--ask] [extra claude args...]
                                  Launch the agent in a lane. Defaults: with, media,
                                  permissions skipped (yolo). Pass --ask to opt
                                  into Claude's normal permission prompts. The
                                  eureka lane requires `./demo init --with-eureka`.

  cli [<sequence-name>]           Run a CLI demo sequence with the press-Enter
                                  shell sequencer. Defaults to demos/demo.txt.

  tokens <session-id>             Report token usage for a Claude Code session.

Each subcommand also exists as a standalone script in scripts/ and can be
invoked directly. The lane symlinks for ./start-agent.sh inside no-trigrep/ and
with-trigrep/ remain functional independently of this dispatcher.

Examples:
  ./demo init
  ./demo reset media
  ./demo trap enable
  ./demo agent                              # = ./demo agent with media (yolo)
  ./demo agent with petclinic
  ./demo agent no media
  ./demo agent with eureka                  # requires ./demo init --with-eureka
  ./demo agent --ask                        # opt into permission prompts
  ./demo cli                                # = ./demo cli demo (demos/demo.txt)
  ./demo tokens 7f3c1234-…-abcd
EOF
}

cmd="${1:-}"
shift || true

case "$cmd" in
  init)
    exec "$SCRIPTS/init.sh" "$@"
    ;;
  reset)
    exec "$SCRIPTS/reset-agent.sh" "$@"
    ;;
  trap)
    exec "$SCRIPTS/trap-mode.sh" "$@"
    ;;
  agent)
    exec "$SCRIPTS/start-agent.sh" "$@"
    ;;
  cli)
    seq_name="${1:-demo}"
    seq_file="$SCRIPT_DIR/demos/${seq_name}.txt"
    if [ ! -f "$seq_file" ]; then
      echo "Sequence file not found: $seq_file" >&2
      exit 1
    fi
    exec "$SCRIPTS/run-sequence.sh" "$seq_file"
    ;;
  tokens)
    exec "$SCRIPTS/session-tokens.sh" "$@"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "" >&2
    usage >&2
    exit 1
    ;;
esac
